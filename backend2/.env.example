# Server Configuration
PORT=8060
NODE_ENV=production

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Secret for Session & Access Tokens
JWT_SECRET=your-super-secret-jwt-key-change-this

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key

# Cloudinary Credentials for File & PDF Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email Service (Gmail SMTP) for Signup OTP Delivery
EMAIL=your-email@gmail.com
PASSWORD=your-gmail-app-password

# Allowed Frontend URL(s) for CORS (comma-separated if multiple)
FRONTEND_URL=https://quick-gyan.vercel.app,http://localhost:3000
